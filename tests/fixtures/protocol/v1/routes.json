      "response_schema": "schemas/reporter-api.schema.json#/$defs/sessionResponse",
      "signature_profile": "reporter-rfc9421-v1",
      "replay_rule": "Consumes the single-use 60-second challenge. Any reuse of a consumed or expired challenge returns 401. Sessions are memory-only and end at 10 minutes idle, one hour total, or core restart."
    },
    {
      "id": "reporter.report.create",
      "surface": "reporter",
      "trust_state": "enrolled-reporter",
      "method": "POST",
      "path_template": "/api/v1/reports",
      "query_forms": [],
      "request_body_max_bytes": 1024,
      "success_body_max_bytes": 1024,
      "success_item_maximum": null,
      "success_status": 200,
      "purpose": "rem-report-v1",
      "request_schema": "schemas/reporter-api.schema.json#/$defs/reportRequest",
      "response_schema": "schemas/reporter-api.schema.json#/$defs/reportResponse",
      "signature_profile": "reporter-rfc9421-v1",
      "replay_rule": "Per session, REM-Sequence strictly increases. A retry of the last accepted sequence with identical body, digest and every signed field returns the recorded status and body with no energy, state or publication side effect; the same sequence with any change, or a lower sequence, returns 409 conflict."
    },
    {
      "id": "reporter.key-rotation-challenge.create",
