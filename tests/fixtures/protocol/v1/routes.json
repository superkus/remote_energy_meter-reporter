{
  "schema": "rem-route-manifest-v1",
  "profile_version": 1,
  "limits": {
    "request_target_max_bytes": 256,
    "header_count_max": 24,
    "header_bytes_max": 8192,
    "signature_header_max_bytes": 1024,
    "signature_input_header_max_bytes": 1024,
    "content_digest_header_max_bytes": 256,
    "problem_response_max_bytes": 2048
  },
  "routes": [
    {
      "id": "reporter.managed-enrollment-challenge.create",
      "surface": "reporter",
      "trust_state": "pre-enrollment",
      "method": "POST",
      "path_template": "/api/v1/managed-enrollment-challenges",
      "query_forms": [],
      "request_body_max_bytes": 1024,
      "success_body_max_bytes": 1024,
      "success_item_maximum": null,
      "success_status": 201,
      "purpose": "rem-managed-enroll-challenge-v1",
      "request_schema": "schemas/reporter-api.schema.json#/$defs/managedEnrollmentChallengeRequest",
      "response_schema": "schemas/reporter-api.schema.json#/$defs/managedEnrollmentChallengeResponse",
      "signature_profile": null,
      "replay_rule": "Stateless. Sent only after the artifact-selected CA-SPKI pin or platform-PKI identity verified. The core allocates nothing; the opaque challenge MAC binds token ID, server identity, proposed thumbprint, core nonce and a 60-second expiry. The challenge is consumed only by the enrollment transaction; a second use is rejected with 401 indistinguishably from any other proof failure."
    },
    {
      "id": "reporter.enrollment.create",
      "surface": "reporter",
      "trust_state": "pre-enrollment",
      "method": "POST",
      "path_template": "/api/v1/enrollments",
      "query_forms": [],
      "request_body_max_bytes": 4096,
      "success_body_max_bytes": 2048,
      "success_item_maximum": null,
      "success_status": 201,
      "purpose": "rem-enroll-v1 rem-managed-enroll-v1",
      "request_schema": "schemas/reporter-api.schema.json#/$defs/enrollmentRequest",
      "response_schema": "schemas/reporter-api.schema.json#/$defs/enrollmentResponse",
      "signature_profile": "reporter-rfc9421-v1",
      "replay_rule": "Body mode selects the tag: interactive uses rem-enroll-v1, managed uses rem-managed-enroll-v1; keyid is the proposed thumbprint. Interactive: memory-only pending state; an exact duplicate while pending returns the original status and body; a different commitment for a live proposed key returns 409 conflict. Managed: one durable transaction consumes token, opaque challenge and reporter nonce and creates the identity; any replay returns 401 authentication_required."
    },
    {
      "id": "reporter.enrollment.reveal",
      "surface": "reporter",
      "trust_state": "pre-enrollment",
      "method": "POST",
      "path_template": "/api/v1/enrollments/{enrollment_id}/reveal",
      "query_forms": [],
      "request_body_max_bytes": 256,
      "success_body_max_bytes": 2048,
      "success_item_maximum": null,
      "success_status": 200,
      "purpose": "rem-enroll-reveal-v1",
      "request_schema": "schemas/reporter-api.schema.json#/$defs/enrollmentRevealRequest",
      "response_schema": "schemas/reporter-api.schema.json#/$defs/enrollmentRevealResponse",
      "signature_profile": "reporter-rfc9421-v1",
      "replay_rule": "Interactive only. An exact duplicate while pending returns the original body; a changed nonce returns 409 conflict; a reporter-commitment mismatch returns 401 and discards the pending enrollment before the core nonce is revealed."
    },
    {
      "id": "reporter.enrollment.confirm",
      "surface": "reporter",
      "trust_state": "pre-enrollment",
      "method": "POST",
      "path_template": "/api/v1/enrollments/{enrollment_id}/confirm",
      "query_forms": [],
      "request_body_max_bytes": 512,
      "success_body_max_bytes": 1024,
      "success_item_maximum": null,
      "success_status": 200,
      "purpose": "rem-enroll-confirm-v1",
      "request_schema": "schemas/reporter-api.schema.json#/$defs/enrollmentConfirmRequest",
      "response_schema": "schemas/reporter-api.schema.json#/$defs/enrollmentConfirmResponse",
      "signature_profile": "reporter-rfc9421-v1",
      "replay_rule": "Interactive only, after reveal. An exact duplicate returns the original body; a transcript digest that differs from the pending transcript, a changed decision, or confirm before reveal returns 409 conflict. Activation requires this confirmation and the HA administrator approval of the same digest."
    },
    {
      "id": "reporter.enrollment.status",
      "surface": "reporter",
      "trust_state": "pre-enrollment",
      "method": "GET",
      "path_template": "/api/v1/enrollments/{enrollment_id}",
      "query_forms": [
        "after_status_generation={uint64}&wait_seconds={0..25}"
      ],
      "request_body_max_bytes": 0,
      "success_body_max_bytes": 2048,
      "success_item_maximum": null,
      "success_status": 200,
      "purpose": "rem-enroll-status-v1",
      "request_schema": null,
      "response_schema": "schemas/reporter-api.schema.json#/$defs/enrollmentStatusResponse",
      "signature_profile": "reporter-rfc9421-v1",
      "replay_rule": "Read-only long poll, at most one parked per pending enrollment. A replay can only read the current public status of the enrollment named by the signing proposed key; it creates or extends nothing."
    },
    {
      "id": "reporter.challenge-context.read",
      "surface": "reporter",
      "trust_state": "server-authenticated",
      "method": "GET",
      "path_template": "/api/v1/challenge-context",
      "query_forms": [],
      "request_body_max_bytes": 0,
      "success_body_max_bytes": 1024,
      "success_item_maximum": null,
      "success_status": 200,
      "purpose": "rem-challenge-context-v1",
      "request_schema": null,
      "response_schema": "schemas/reporter-api.schema.json#/$defs/challengeContextResponse",
      "signature_profile": null,
      "replay_rule": "Stateless and unsigned; served only after the reporter verified the server per its enrolled trust mode. The context is MAC-bound to the current core boot and five-minute interval, grants nothing on its own and is never extended by a request."
    },
    {
      "id": "reporter.challenge.create",
      "surface": "reporter",
      "trust_state": "enrolled-reporter",
      "method": "POST",
      "path_template": "/api/v1/challenges",
      "query_forms": [],
      "request_body_max_bytes": 512,
      "success_body_max_bytes": 1024,
      "success_item_maximum": null,
      "success_status": 201,
      "purpose": "rem-challenge-v1",
      "request_schema": "schemas/reporter-api.schema.json#/$defs/challengeRequest",
      "response_schema": "schemas/reporter-api.schema.json#/$defs/challengeResponse",
      "signature_profile": "reporter-rfc9421-v1",
      "replay_rule": "One live challenge per reporter. An exact duplicate while the challenge is live returns it with its original expiry; a different client nonce while live, or a nonce already seen in the allocation context, returns 409 conflict without allocation. Replay records live until the allocation context expires."
    },
    {
      "id": "reporter.session.create",
      "surface": "reporter",
      "trust_state": "enrolled-reporter",
      "method": "POST",
      "path_template": "/api/v1/sessions",
      "query_forms": [],
      "request_body_max_bytes": 1024,
      "success_body_max_bytes": 1024,
      "success_item_maximum": null,
      "success_status": 201,
      "purpose": "rem-session-v1",
