  "description": "Interactive commit-before-reveal enrollment, transcript, digest and six-byte SAS derivation.",
  "cases": [
    {
      "id": "interactive.commitments",
      "description": "commitment = SHA-256(encode('rem-interactive-commit-v1', [('role', role), ('nonce', nonce)])) for role 'reporter' and 'core'. Reporter reveals first; the core rejects a mismatch before revealing; the reporter then verifies the core commitment.",
