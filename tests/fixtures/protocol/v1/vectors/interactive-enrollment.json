      "expected": {
        "accept": true,
        "status": null,
        "outputs": [
          {
            "name": "reporter_commitment",
            "encoding": "base64url",
            "value": "z9eKUQtsUV9F4SlCmY28nfxQfSwlMhHVQ2Ybz9pEec4"
          },
          {
            "name": "core_commitment",
