    {
      "id": "common.problem-response",
      "description": "Closed RFC 9457 problem: exactly type, title, status and code; status equals the HTTP status mapped from code; no member echoes input; the complete response including headers fits 2 KiB.",
      "requirements": [
        "6.1",
        "6.8"
      ],
      "routes": [],
      "inputs": [
        {
          "name": "code",
          "encoding": "ascii",
          "value": "conflict"
        }
      ],
      "intermediates": [
        {
          "name": "body",
          "encoding": "utf8",
          "value": "{\"code\":\"conflict\",\"status\":409,\"title\":\"Conflict\",\"type\":\"https://remote-energy-meter.example/protocol/v1/problems/conflict\"}"
        },
        {
          "name": "response.length",
          "encoding": "decimal",
          "value": "237"
        }
      ],
      "expected": {
        "accept": true,
        "status": null,
        "outputs": [
          {
            "name": "response",
            "encoding": "ascii",
            "value": "HTTP/1.1 409 Conflict\r\nContent-Type: application/problem+json\r\nCache-Control: no-store\r\nContent-Length: 126\r\n\r\n{\"code\":\"conflict\",\"status\":409,\"title\":\"Conflict\",\"type\":\"https://remote-energy-meter.example/protocol/v1/problems/conflict\"}"
          }
        ]
      },
      "substitutes": [
        {
          "field": "body.status",
          "replacement": {
            "name": "body.status",
            "encoding": "decimal",
            "value": "410"
          }
        },
        {
          "field": "body.code",
          "replacement": {
            "name": "body.code",
            "encoding": "ascii",
            "value": "conflict_detail"
          }
        }
      ],
      "mutations": [
        {
          "id": "common.problem-response.m00",
          "field": "body.status",
          "operation": "substitute",
          "expected_code": "internal_error"
        },
        {
          "id": "common.problem-response.m01",
          "field": "body.code",
          "operation": "substitute",
          "expected_code": "internal_error"
        },
        {
          "id": "common.problem-response.m02",
          "field": "body.detail",
          "operation": "duplicate",
          "expected_code": "internal_error"
        },
        {
          "id": "common.problem-response.m03",
          "field": "headers.content-type",
          "operation": "alter-value",
          "expected_code": "internal_error"
        }
      ]
    },
    {
      "id": "common.roster-snapshot-digest",
