        "8.6f",
        "8.6g"
      ],
      "routes": [
        "control.roster.snapshot"
      ],
      "inputs": [
        {
          "name": "snapshot_id",
          "encoding": "base64url",
          "value": "GBgYGBgYGBgYGBgYGBgYGA"
        },
        {
          "name": "snapshot_generation",
          "encoding": "decimal",
          "value": "9"
        },
        {
          "name": "record[0]",
          "encoding": "utf8",
          "value": "{\"active_key_generation\":1,\"active_key_thumbprint\":\"XvXTjzJmaKXJaWfpsV9mUH4K2PpAF6SjWjhbcCN9dIU\",\"enrollment_mode\":\"interactive\",\"metadata\":{\"architecture\":\"arm64\",\"display_name\":\"Studio laptop\",\"platform\":\"macos\",\"reporter_version\":\"0.1.0\"},\"pending_enrollment\":null,\"pending_key_rotation\":null,\"record_state\":\"active\",\"reporter_id\":\"XvXTjzJmaKXJaWfpsV9mUH4K2PpAF6SjWjhbcCN9dIU\",\"reporter_state_generation\":3}"
        }
      ],
      "intermediates": [
        {
          "name": "records.stream",
