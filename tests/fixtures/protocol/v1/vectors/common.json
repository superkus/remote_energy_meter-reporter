          "value": ""
        },
        {
          "name": "transcript",
          "encoding": "hex",
          "value": ""
        }
      ],
      "expected": {
        "accept": true,
        "status": null,
        "outputs": [
          {
            "name": "completeness_digest",
            "encoding": "base64url",
            "value": "-kHfqn0ddRRnH4RADC4fB_AW6D_H_CN_QQjzksJzGfc"
          }
        ]
      },
      "substitutes": [],
      "mutations": [
        {
          "id": "common.roster-snapshot-digest.m00",
          "field": "snapshot_id",
          "operation": "alter-byte",
          "expected_code": "stale_snapshot"
        },
        {
          "id": "common.roster-snapshot-digest.m01",
          "field": "snapshot_generation",
          "operation": "alter-value",
          "expected_code": "stale_snapshot"
        },
        {
          "id": "common.roster-snapshot-digest.m02",
          "field": "record[0]",
          "operation": "alter-byte",
          "expected_code": "stale_snapshot"
