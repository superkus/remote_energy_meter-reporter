    {
      "id": "common.content-digest",
      "description": "RFC 9530 Content-Digest over the exact canonical body bytes; only sha-256, one member, RFC 8941 byte sequence with standard padded base64.",
      "requirements": [
        "6.1",
        "6.5",
        "7.5f"
      ],
      "routes": [
        "reporter.report.create"
      ],
      "inputs": [
        {
          "name": "body",
          "encoding": "utf8",
          "value": "{\"state\":\"available\",\"watts\":12.5}"
        }
      ],
      "intermediates": [
        {
          "name": "body.sha256",
          "encoding": "hex",
          "value": "d24c693eb8f99f7241d943fd1c3394498deb6743da0d4fab696665538119ef7d"
        }
      ],
      "expected": {
        "accept": true,
        "status": null,
        "outputs": [
          {
            "name": "headers.content-digest",
            "encoding": "ascii",
            "value": "sha-256=:0kxpPrj5n3JB2UP9HDOUSY3rZ0PaDU+raWZlU4EZ730=:"
          }
        ]
      },
      "substitutes": [
        {
          "field": "headers.content-digest",
          "replacement": {
            "name": "headers.content-digest",
            "encoding": "ascii",
            "value": "sha-512=:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==:"
          }
        },
        {
          "field": "body",
          "replacement": {
            "name": "body",
            "encoding": "utf8",
            "value": "{\"watts\":12.5,\"state\":\"available\"}"
          }
        }
      ],
      "mutations": [
        {
          "id": "common.content-digest.m00",
          "field": "headers.content-digest",
          "operation": "substitute",
          "expected_code": "invalid_request"
        },
        {
          "id": "common.content-digest.m01",
          "field": "body",
          "operation": "substitute",
          "expected_code": "invalid_request"
        },
        {
          "id": "common.content-digest.m02",
          "field": "body.sha256",
          "operation": "alter-byte",
          "expected_code": "invalid_request"
        },
        {
          "id": "common.content-digest.m03",
          "field": "headers.content-digest.member",
          "operation": "duplicate",
          "expected_code": "invalid_request"
        }
      ]
    },
    {
      "id": "common.server-identity",
      "description": "Interactive server_identity is exactly https://<canonical lowercase IDNA2008 A-label host>:<canonical port>, at most 267 bytes, with no userinfo, path, query, fragment, percent encoding, malformed or noncanonical A-label, IP literal, or alternate numeric IP form recognized by the connection stack.",
      "requirements": [
        "4.3",
        "4.5"
      ],
      "routes": [
        "reporter.enrollment.create"
      ],
      "inputs": [
        {
          "name": "host",
          "encoding": "ascii",
          "value": "ha.example.com"
        },
        {
          "name": "port",
          "encoding": "decimal",
          "value": "58443"
        }
      ],
      "intermediates": [
        {
          "name": "server_identity.hex",
          "encoding": "hex",
          "value": "68747470733a2f2f68612e6578616d706c652e636f6d3a3538343433"
        }
      ],
      "expected": {
        "accept": true,
        "status": null,
        "outputs": [
          {
            "name": "server_identity",
            "encoding": "ascii",
            "value": "https://ha.example.com:58443"
          }
        ]
      },
      "substitutes": [
        {
          "field": "host",
          "replacement": {
            "name": "host",
            "encoding": "ascii",
            "value": "HA.example.com"
          }
        },
        {
          "field": "port",
          "replacement": {
            "name": "port",
            "encoding": "ascii",
            "value": "058443"
          }
        },
        {
          "field": "server_identity.path",
          "replacement": {
            "name": "server_identity.path",
            "encoding": "ascii",
            "value": "https://ha.example.com:58443/"
          }
        },
        {
          "field": "server_identity.literal",
          "replacement": {
            "name": "server_identity.literal",
            "encoding": "ascii",
            "value": "https://192.0.2.10:58443"
          }
        },
        {
          "field": "server_identity.alternate-ip",
          "replacement": {
            "name": "server_identity.alternate-ip",
            "encoding": "ascii",
            "value": "https://0xc000020a:58443"
          }
        },
        {
          "field": "server_identity.malformed-alabel",
          "replacement": {
            "name": "server_identity.malformed-alabel",
            "encoding": "ascii",
            "value": "https://xn--a.example:58443"
          }
        },
        {
          "field": "server_identity.trailing-dot",
          "replacement": {
            "name": "server_identity.trailing-dot",
            "encoding": "ascii",
            "value": "https://ha.example.com.:58443"
          }
        },
        {
          "field": "server_identity.userinfo",
          "replacement": {
            "name": "server_identity.userinfo",
            "encoding": "ascii",
            "value": "https://u@ha.example.com:58443"
          }
        }
      ],
      "mutations": [
        {
          "id": "common.server-identity.m00",
          "field": "host",
          "operation": "substitute",
          "expected_code": "invalid_request"
        },
        {
          "id": "common.server-identity.m01",
          "field": "port",
          "operation": "substitute",
          "expected_code": "invalid_request"
        },
        {
          "id": "common.server-identity.m02",
          "field": "server_identity.path",
          "operation": "substitute",
          "expected_code": "invalid_request"
        },
        {
          "id": "common.server-identity.m03",
          "field": "server_identity.literal",
          "operation": "substitute",
          "expected_code": "invalid_request"
        },
        {
          "id": "common.server-identity.m04",
          "field": "server_identity.trailing-dot",
          "operation": "substitute",
          "expected_code": "invalid_request"
        },
        {
          "id": "common.server-identity.m05",
          "field": "server_identity.userinfo",
          "operation": "substitute",
          "expected_code": "invalid_request"
        },
        {
          "id": "common.server-identity.m06",
          "field": "server_identity.hex",
          "operation": "alter-byte",
          "expected_code": "conflict"
        },
        {
          "id": "common.server-identity.m07",
          "field": "server_identity.alternate-ip",
          "operation": "substitute",
          "expected_code": "invalid_request"
        },
        {
          "id": "common.server-identity.m08",
          "field": "server_identity.malformed-alabel",
          "operation": "substitute",
          "expected_code": "invalid_request"
        }
      ]
