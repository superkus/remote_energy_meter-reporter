      "requirements": [
        "3.1",
        "6.1"
      ],
      "routes": [],
      "inputs": [
        {
          "name": "jwk.x",
          "encoding": "base64url",
          "value": "qXlTk75KQKYN-PBJPDM4qHw8tYKgDLaqixcHrthpc_U"
        },
        {
          "name": "jwk.y",
          "encoding": "base64url",
          "value": "tdXohmn4d0O78ACF989uLrxgHWAryPJteiOQIvBjRDo"
        }
      ],
      "intermediates": [
        {
          "name": "jwk.canonical",
          "encoding": "utf8",
          "value": "{\"crv\":\"P-256\",\"kty\":\"EC\",\"x\":\"qXlTk75KQKYN-PBJPDM4qHw8tYKgDLaqixcHrthpc_U\",\"y\":\"tdXohmn4d0O78ACF989uLrxgHWAryPJteiOQIvBjRDo\"}"
        },
        {
          "name": "jwk.canonical.hex",
          "encoding": "hex",
