{
  "schema": "rem-vector-set-v1",
  "profile_version": 1,
  "description": "Common encodings: REM-TRANSCRIPT, RFC 7638 thumbprints, RFC 9530 Content-Digest, canonical JSON, server identity, problem responses and roster snapshot digest.",
  "cases": [
    {
      "id": "common.transcript-encoding",
      "description": "encode(purpose, fields) = 'REM-TRANSCRIPT' || 0x01 || uint16be(len(purpose)) || purpose || for each field: uint16be(len(name)) || name || uint32be(len(value)) || value. Shown on the interactive reporter commitment input. A decoder that parses transcripts must reject every mutation below.",
      "requirements": [
        "4.3",
        "7.5a"
      ],
      "routes": [],
      "inputs": [
        {
          "name": "purpose",
          "encoding": "ascii",
          "value": "rem-interactive-commit-v1"
        },
        {
          "name": "field.role",
          "encoding": "ascii",
          "value": "reporter"
        },
        {
          "name": "field.nonce",
          "encoding": "hex",
          "value": "1111111111111111111111111111111111111111111111111111111111111111"
        }
      ],
      "intermediates": [
        {
          "name": "transcript.encoded.header",
          "encoding": "hex",
          "value": "52454d2d5452414e53435249505401"
        },
        {
          "name": "transcript.encoded.purpose",
          "encoding": "hex",
          "value": "001972656d2d696e7465726163746976652d636f6d6d69742d7631"
        },
        {
          "name": "transcript.encoded.role",
          "encoding": "hex",
          "value": "0004726f6c65000000087265706f72746572"
        },
        {
          "name": "transcript.encoded.nonce",
          "encoding": "hex",
          "value": "00056e6f6e6365000000201111111111111111111111111111111111111111111111111111111111111111"
        }
      ],
      "expected": {
        "accept": true,
        "status": null,
        "outputs": [
          {
            "name": "transcript",
            "encoding": "hex",
            "value": "52454d2d5452414e53435249505401001972656d2d696e7465726163746976652d636f6d6d69742d76310004726f6c65000000087265706f7274657200056e6f6e6365000000201111111111111111111111111111111111111111111111111111111111111111"
          },
          {
            "name": "transcript.length",
            "encoding": "decimal",
            "value": "103"
          }
        ]
      },
      "substitutes": [],
      "mutations": [
        {
          "id": "common.transcript-encoding.m00",
          "field": "transcript.encoded.header",
          "operation": "alter-byte",
          "expected_code": "invalid_request"
        },
        {
          "id": "common.transcript-encoding.m01",
          "field": "transcript.encoded.purpose",
          "operation": "alter-byte",
          "expected_code": "invalid_request"
        },
        {
          "id": "common.transcript-encoding.m02",
          "field": "field.role",
          "operation": "duplicate",
          "expected_code": "invalid_request"
        },
        {
          "id": "common.transcript-encoding.m03",
          "field": "field.nonce",
          "operation": "omit",
          "expected_code": "invalid_request"
        },
        {
          "id": "common.transcript-encoding.m04",
          "field": "transcript.encoded.role",
          "operation": "reorder",
          "expected_code": "invalid_request"
        },
        {
          "id": "common.transcript-encoding.m05",
          "field": "transcript.encoded.nonce",
          "operation": "alter-value",
          "expected_code": "invalid_request"
        }
      ]
    },
    {
      "id": "common.jwk-thumbprint",
