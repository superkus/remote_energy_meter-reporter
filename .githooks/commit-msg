#!/bin/sh
# Reject unpublished local context and credentials in the pending commit message.
set -eu
umask 077
[ "$#" -eq 1 ] || { echo "commit-msg requires one message file" >&2; exit 1; }
message_file=$1
cd "$(git rev-parse --show-toplevel)"
need() { command -v "$1" >/dev/null 2>&1 || { echo "missing required tool: $1" >&2; exit 1; }; }
need gitleaks
need python3
gitleaks_version=$(gitleaks version 2>/dev/null) || { echo "failed to read gitleaks version" >&2; exit 1; }
[ "$gitleaks_version" = "8.30.1" ] || { echo "required gitleaks version: 8.30.1" >&2; exit 1; }

python3 tools/check_local_refs.py --message-file "$message_file"
gitleaks stdin --config .gitleaks.toml --redact --no-banner < "$message_file"
